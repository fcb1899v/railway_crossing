**/dgph
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
# Not *.strings: Runner/*.lproj/*.strings are the app's own localizations.
# Not *.plist: that also hid Runner/Info.plist and Flutter/AppFrameworkInfo.plist,
# both of which the build needs. Name the one that should stay out.
# Not google-services.json / GoogleService-Info.plist: every app here applies
# the com.google.gms.google-services Gradle plugin, which fails the Android
# build when the json is absent, and six of the eight Xcode projects list the plist
# in their Resources build phase. Both files hold the same identifiers as
# lib/firebase_options.dart and ship inside the app, so excluding them hid
# nothing and cost two apps their copy (kawaii and letswashlet, 2026-09-02).
# Not *.entitlements: Runner/Runner.entitlements carries the Game Center and
# push capabilities. Without it the app will not sign.
**/*sync/
.sconsign.dblite
.tags*
**/.vagrant/
**/DerivedData/
Icon?
**/Pods/
**/.symlinks/
profile
xcuserdata
**/.generated/
Flutter/App.framework
Flutter/Flutter.framework
Flutter/Flutter.podspec
Flutter/Generated.xcconfig
Flutter/ephemeral/
Flutter/app.flx
Flutter/app.zip
Flutter/flutter_assets/
Flutter/flutter_export_environment.sh
ServiceDefinitions.json
Runner/GeneratedPluginRegistrant.*

# Exceptions to above rules.
!default.mode1v3
!default.mode2v3
!default.pbxuser
!default.perspectivev3
