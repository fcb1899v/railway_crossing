rules_version = '2';

// The document id is device_<platform>_<deviceId> or player_<platform>_<playerId>, not the uid, so a balance survives a reinstall that resets the anonymous uid (lib/ticket_manager.dart).
// So the rules can reject malformed, back-dated and out-of-range writes but cannot prove a ticket count was earned, which needs the spend moved into functions/index.js.

service cloud.firestore {
  match /databases/{database}/documents {

    match /tickets/{ticketId} {
      allow read: if isSignedIn() && isWellFormedId(ticketId);

      allow create: if isSignedIn()
        && isWellFormedId(ticketId)
        && isWellFormedPayload(ticketId);

      // resource is the stored document, so the daily claim can only move forward; create has nothing to compare.
      allow update: if isSignedIn()
        && isWellFormedId(ticketId)
        && isWellFormedPayload(ticketId)
        && request.resource.data.lastClaimed >= resource.data.lastClaimed;

      // The app never deletes, and an open delete would let one request throw away a paid balance.
      allow delete: if false;
    }

    // Rules do not cascade, so this explicit deny makes a later broad match remove it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Anonymous sign-in (lib/common_function.dart) is not proof of identity because everyone gets a uid.
// It only keeps out callers that never went through the app.
function isSignedIn() {
  return request.auth != null;
}

function isWellFormedId(ticketId) {
  return ticketId.matches('^(device|player)_(ios|android)_[A-Za-z0-9_-]{1,128}$');
}

function isWellFormedPayload(ticketId) {
  return hasExactlyTheExpectedFields()
    && typesAreRight()
    && platformMatchesId(ticketId)
    && withinBounds()
    && isNotPostDated();
}

function hasExactlyTheExpectedFields() {
  return request.resource.data.keys().hasOnly([
      'tickets', 'expiration', 'lastClaimed', 'platform', 'updatedAtMs'
    ])
    && request.resource.data.keys().hasAll([
      'tickets', 'expiration', 'lastClaimed', 'platform', 'updatedAtMs'
    ]);
}

function typesAreRight() {
  return request.resource.data.tickets is int
    && request.resource.data.expiration is int
    && request.resource.data.lastClaimed is int
    && request.resource.data.updatedAtMs is int
    && request.resource.data.platform in ['ios', 'android'];
}

// A platform that disagrees with the id means the write did not come from the code that builds these ids.
function platformMatchesId(ticketId) {
  return (request.resource.data.platform == 'ios'
          && ticketId.matches('^(device|player)_ios_.*'))
      || (request.resource.data.platform == 'android'
          && ticketId.matches('^(device|player)_android_.*'));
}

// 999 only caps the damage, against a largest single grant of 72 (onetimeTicketLimitNumber in lib/constant.dart).
// updatedAtMs is epoch milliseconds (lib/ticket_manager.dart) while lastClaimed and expiration are yyyyMMddHHmmss, so mixing the scales would lock every user out.
function withinBounds() {
  return request.resource.data.tickets >= 0
    && request.resource.data.tickets <= 999
    && isDateShaped(request.resource.data.lastClaimed)
    && isDateShaped(request.resource.data.expiration)
    && request.resource.data.updatedAtMs >= 0;
}

// The year 1000 to 3000 bounds on yyyyMMddHHmmss ints (defaultIntDateTime in lib/constant.dart) reject wrong-scale values without pinning a date.
// 0 is allowed because it means never claimed.
function isDateShaped(value) {
  return value == 0
    || (value >= 10000000000000 && value <= 30000000000000);
}

// updatedAtMs decides local-vs-cloud on the next launch (lib/ticket_manager.dart), so a future stamp would win that comparison forever.
// Five minutes absorbs clock skew.
function isNotPostDated() {
  return request.resource.data.updatedAtMs <= request.time.toMillis() + 300000;
}
