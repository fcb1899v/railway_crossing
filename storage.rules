rules_version = '2';

// The bucket holds generated train photos, written and read only by
// functions/index.js through the Admin SDK, which bypasses these rules.
// The app never touches Storage directly (no firebase_storage dependency),
// so every client request is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
