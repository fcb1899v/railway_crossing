rules_version = '2';

// Only functions/index.js reads and writes the generated train photos, through the Admin SDK, which bypasses these rules.
// The app has no firebase_storage dependency, so every client request is denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
