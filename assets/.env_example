# Template for assets/.env, which is untracked. Copy this to that name and fill
# in the values. pubspec.yaml lists assets/.env, so the file has to exist or the
# build fails; this template is not listed and is not bundled.
#
# Named with an underscore, not .env.example: the repository's Claude Code
# settings deny Edit(**/.env.*), so a dotted name could not be maintained here.
#
# Everything here ships inside the release bundle.
# Nothing whose leak would matter belongs here.

# Production ad unit ids are not written in this file; pass a file outside the repository with --dart-define-from-file when building a release.

# RevenueCat public SDK keys. These are the app-side keys, meant to ship in the
# client; the secret key never goes near this repository.
REVENUE_CAT_IOS_API_KEY=
REVENUE_CAT_ANDROID_API_KEY=

# App Check debug tokens do not go in this file; pass them with --dart-define-from-file when you run a debug build.
